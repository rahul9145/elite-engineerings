{
  "redirects": [
    { "source": "/blog.html", "destination": "/", "permanent": true },
    { "source": "/blog-post.html", "destination": "/", "permanent": true },
    { "source": "/services-detail.html", "destination": "/services.html", "permanent": true },
    { "source": "/products-detail.html", "destination": "/products.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
